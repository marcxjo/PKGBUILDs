# Maintainer: Marko Givens <marcxjo@cerebralbleach.com>
pkgname=firefox-cfg
pkgver=0.0.1
pkgrel=2
epoch=1
pkgdesc='Security-focused global configuration for Firefox'
arch=('any')
url='https://github.com/marcxjo/PKGBUILDS'
license=('MIT')
depends=('firefox')
source=(
  "autoconfig.js"
  "firefox.cfg"
)
sha256sums=(
  '464607275f20dde40b1732c7270c1e74c06452c6155726544fe2b244b1b7120e'
  '599281610a294cb659ebb83bfd43e84e4e63ec9efc2da3a8f70a9af35e7f0338'
)

package() {
        install -dm755 "${pkgdir}"/usr/lib/firefox/defaults/pref/
        install -Dm644 "${srcdir}"/autoconfig.js "${pkgdir}"/usr/lib/firefox/defaults/pref/autoconfig.js
        install -Dm644 "${srcdir}"/firefox.cfg "${pkgdir}"/usr/lib/firefox/firefox.cfg
}
